{
    "name": "stackradar/laravel",
    "description": "Laravel integration for StackRadar runtime dependency inventory.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "stackradar/php": "^0.1"
    },
    "require-dev": {
        "laravel/octane": "^2.15",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {"psr-4": {"StackRadar\\Laravel\\": "src/"}},
    "autoload-dev": {"psr-4": {"StackRadar\\Laravel\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["StackRadar\\Laravel\\StackRadarServiceProvider"]}},
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "pint",
        "check": ["pint --test", "@analyse", "@test"]
    },
    "config": {"sort-packages": true}
}
